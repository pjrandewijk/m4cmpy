{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "M4 Circuit Macros",
  "comment": "Generated by m4cm_defines.py from Circuit Macros 11.1; do not edit by hand.",
  "scopeName": "source.m4cm",
  "patterns": [
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "statement": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#dnl"
        },
        {
          "include": "#picture"
        },
        {
          "include": "#string"
        },
        {
          "include": "#m4-quote"
        },
        {
          "include": "#label"
        },
        {
          "include": "#m4-builtin"
        },
        {
          "include": "#circuit-macro"
        },
        {
          "include": "#pic-control"
        },
        {
          "include": "#pic-primitive"
        },
        {
          "include": "#pic-function"
        },
        {
          "include": "#pic-variable"
        },
        {
          "include": "#pic-keyword"
        },
        {
          "include": "#corner"
        },
        {
          "include": "#argument"
        },
        {
          "include": "#tex"
        },
        {
          "include": "#ordinal"
        },
        {
          "include": "#number"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.m4cm",
      "match": "#.*$"
    },
    "dnl": {
      "name": "comment.line.dnl.m4",
      "match": "\\bdnl\\b.*$"
    },
    "picture": {
      "name": "keyword.control.directive.pic",
      "match": "^\\.P[SEF]\\b"
    },
    "string": {
      "name": "string.quoted.double.pic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\\"",
          "name": "constant.character.escape.pic"
        },
        {
          "include": "#argument"
        },
        {
          "include": "#tex"
        }
      ]
    },
    "m4-quote": {
      "name": "string.quoted.other.m4",
      "begin": "`",
      "end": "'",
      "patterns": [
        {
          "include": "#statement"
        }
      ]
    },
    "label": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(:)(?!=)",
      "captures": {
        "1": {
          "name": "entity.name.label.pic"
        },
        "2": {
          "name": "punctuation.separator.label.pic"
        }
      }
    },
    "m4-builtin": {
      "name": "support.function.builtin.m4",
      "match": "\\b(?:changequote|changecom|debugfile|debugmode|errprint|maketemp|patsubst|sinclude|traceoff|translit|undefine|undivert|builtin|dumpdef|esyscmd|include|mkstemp|pushdef|traceon|define|divert|divnum|format|ifelse|m4exit|m4wrap|popdef|regexp|substr|syscmd|sysval|ifdef|index|indir|shift|decr|defn|eval|incr|dnl|len)\\b"
    },
    "circuit-macro": {
      "name": "support.function.circuit-macros",
      "match": "\\b(?:DefineCMYKColor|sl_transformer3|DefineHSVColor|DefineRGBColor|definergbcolor|sl_transformer|NeedDpicTools|ShadedPolygon|arcdimension_|potentiometer|stackpromote_|stackreverse_|RotarySwitch|hexadecimal_|ifpostscript|restorem4dir|sl_capacitor|sl_generator|sl_rectifier|thermocouple|BUFFER_gate|Deltasymbol|LCintersect|LEintersect|ShadeObject|centerline_|darrow_init|dpquicksort|sl_inductor|sl_inverter|sl_meterbox|stackprint_|stacksplit_|thicklines_|threeD_init|thyristor_t|transformer|BUFFER_gen|Cintersect|Darlington|Intersect_|NOT_circle|RightAngle|SIdefaults|arcwinding|beginshade|delay_rad_|deleminit_|dfillcolor|dfitpoints|dimension_|ellipsearc|gpolyline_|graystring|ifpstricks|inner_prod|integrator|intersect_|linethick_|microphone|open_arrow|rotellipse|shadedball|sl_breaker|sl_drawout|sl_reactor|sourcerad_|stackargs_|stackcopy_|stackexec_|thinlines_|tr_xy_init|Autologix|Equidist3|FlipFlopX|HeaderPin|LCtangent|LEtangent|LH_symbol|LT_symbol|Loopover_|NAND_gate|NXOR_gate|arrowline|b_current|basename_|capacitor|cct_minus|cmyktorgb|consource|crossover|dcosine3D|dfitcurve|eleminit_|em_arrows|hex_digit|indicator|l_contact|lg_bartxt|lg_pintxt|m4lstring|manhattan|memristor|parallel_|posarray2|proximity|pushkeys_|relaycoil|resetdir_|rgbstring|rgbtocmyk|savem4dir|sl_busbar|thyristor|ACsymbol|AND_gate|ArcAngle|AutoGate|BOX_gate|Between_|ColoredV|DCsymbol|FlipFlop|NOR_gate|NOT_gate|Vcoords_|XOR_gate|arraymax|arraymin|arrester|bi_trans|boxcoord|cbreaker|cct_init|cct_plus|contacts|contline|copythru|crosswd_|dashline|distance|dlinewid|earphone|endshade|findroot|fitcurve|foreach_|gen_init|hatchbox|heatsink|histbins|hsvtorgb|ifpsfrag|incircle|inductor|length3D|lin_leng|log_init|m4_arrow|m4dupstr|m4xtract|nullator|posarray|pushkey_|resetrgb|resistor|reversed|rgbtohsv|setkeys_|sfg_init|sfgabove|sfgbelow|shadebox|shadowed|shielded|sinusoid|sl_slash|sl_ttbox|slantbox|stackdo_|testexpr|tikznode|variable|AND_gen|KelvinR|Mux_wid|Mx_pins|NOT_rad|OR_gate|Vsprod_|XOR_off|Ysymbol|addtaps|antenna|assign3|battery|binary_|bswitch|contact|cross3D|dotrad_|dprtext|dswitch|glabel_|gyrator|heatere|heatert|hoprad_|ifinstr|ifmfpic|ifmpost|length3|lg_plen|lin_ang|log10E_|lswitch|m4xpand|norator|pconnex|polygon|print3D|project|resized|rgbdraw|rgbfill|rpoint_|sc_draw|series_|setdir_|setkey_|setview|sfgline|sfgnode|sfgself|sl_disk|sl_grid|sl_lamp|sl_load|speaker|sprod3D|ttmotor|vlength|winding|AND_ht|AND_wd|Along_|BUF_ht|BUF_wd|Buffer|Cosine|Darrow|FF_wid|Fe_fet|Fector|Header|IOdefs|L_unit|Mitre_|Mux_ht|N_diam|OR_gen|OR_rad|PerpTo|Point_|Proxim|Vdiff_|View3D|above_|adjust|along_|array2|below_|bisect|boxdim|buzzer|cangle|clabel|corner|cross3|csdim_|dabove|darrow|dbelow|diff3D|dimen_|dlabel|dljust|dright|drjust|elchop|geiger|ground|gshade|heater|ifdpic|ifgpic|ifroff|ifxfig|jumper|l_coil|langle|larrow|lg_pin|ljust_|llabel|lthick|mitre_|mosfet|perpto|point_|polar_|psset_|ptrans|pvcell|r_stub|r_text|rarrow|right_|rjust_|rlabel|rot3Dx|rot3Dy|rot3Dz|rotbox|rs_box|rsvec_|rtod__|rvec_r|s_init|s_name|sarrow|setrgb|sfgarc|sl_box|source|sprod3|switch|tapped|tstrip|twopi_|unit3D|vscal_|while_|xtract|Demux|Dline|FF_ht|FTcap|G_hht|N_rad|Pconn|Rect_|SQUID|ToPos|Vperp|Vsum_|Zdiff|Zprod|arcto|array|bi_tr|c_fet|ccoax|copy3|cross|d_fet|delay|diff3|diff_|diode|dleft|dline|dot3D|down_|dprot|dtor_|dturn|e_fet|elen_|f_box|fill_|g_fet|gpar_|grid_|ifpgf|j_fet|left_|lp_xy|nport|nterm|opamp|prod_|randn|rect_|relay|round|rpos_|rrot_|rtod_|rvec_|s_box|shade|sidac|sign_|sl_ct|sqrta|sum3D|svec_|ta_xy|tconn|tgate|tline|tr_xy|vec_r|vperp|vrot_|Darc|H_ht|Int_|Magn|NPDT|Nand|Nxor|PtoL|Rot_|Zcos|Zexp|Zinv|Zsin|Zsum|abs_|arca|arcd|arcr|bell|bp__|case|cm__|cosd|darc|dend|dir_|dna_|dnm_|dot3|dtee|ebox|expe|for_|fuse|hlth|igbt|in__|jack|lamp|lbox|loc_|loge|loop|lpop|mm__|neg_|pc__|plug|pmod|pt__|px__|reed|rot_|s_dp|s_ht|s_wd|sinc|sind|sum3|sum_|tbox|up__|vec3|vec_|wid_|xtal|zabs|zarg|And|Cos|DIP|E__|Max|Min|Mux|Nor|Not|Sin|Xor|adc|amp|dac|dn_|dot|gap|ht_|lt_|ne_|nw_|pi_|rt_|sbs|scr|scs|se_|sp_|sus|sw_|ujt|up_|Or|b_|e_|g_|n_|r_|s_|w_)\\b"
    },
    "pic-control": {
      "name": "keyword.control.pic",
      "match": "\\b(?:undefine|command|define|print|reset|undef|copy|else|exec|then|for|do|if|sh)\\b"
    },
    "pic-primitive": {
      "name": "storage.type.primitive.pic",
      "match": "\\b(?:ellipse|circle|spline|arrow|line|move|arc|box)\\b"
    },
    "pic-function": {
      "name": "support.function.math.pic",
      "match": "\\b(?:sprintf|atan2|floor|acos|asin|expe|loge|pmod|rand|sign|sqrt|abs|cos|exp|int|log|max|min|sin|tan)\\b"
    },
    "pic-variable": {
      "name": "variable.language.pic",
      "match": "\\b(?:optPSTricks|ellipsewid|textoffset|arrowhead|circlerad|ellipseht|linethick|optPSfrag|optPict2e|arrowwid|maxpswid|optMFpic|optMpost|arrowht|dashwid|dpicopt|fillval|linewid|maxpsht|movewid|optsafe|opttTeX|optxfig|textwid|arcrad|boxrad|boxwid|lineht|moveht|optPDF|optPGF|optSVG|optTeX|textht|boxht|optPS|scale|Here)\\b"
    },
    "pic-keyword": {
      "name": "keyword.other.pic",
      "match": "\\b(?:invisible|thickness|coloured|continue|diameter|outlined|between|colored|outline|bottom|center|centre|colour|dashed|dotted|filled|height|radius|scaled|shaded|above|below|color|invis|ljust|right|rjust|shade|solid|start|thick|width|chop|diam|down|fill|from|last|left|same|with|and|ccw|end|rad|the|top|way|wid|at|by|cw|ht|of|to|up)\\b"
    },
    "corner": {
      "name": "variable.other.property.pic",
      "match": "\\.(?:thickness|diameter|bottom|center|centre|height|length|radius|north|right|south|start|thick|width|diam|east|left|west|bot|end|len|rad|top|wid|ht|ne|nw|se|sw|b|c|e|l|n|r|s|t|w|x|y)\\b"
    },
    "argument": {
      "name": "variable.parameter.m4cm",
      "match": "\\$(?:\\d+|[#*@+])"
    },
    "tex": {
      "name": "support.function.tex",
      "match": "\\\\[A-Za-z]+"
    },
    "ordinal": {
      "name": "constant.numeric.ordinal.pic",
      "match": "\\b\\d+(?:st|nd|rd|th)\\b"
    },
    "number": {
      "name": "constant.numeric.pic",
      "match": "(?<![\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?"
    }
  }
}
