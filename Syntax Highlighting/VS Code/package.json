{
  "name": "m4cm",
  "displayName": "M4 Circuit Macros",
  "description": "Syntax highlighting for M4 Circuit Macros (.m4cm) diagrams: m4, dpic/pic and the Circuit Macros library",
  "version": "1.0.0",
  "publisher": "pjrandewijk",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/pjrandewijk/m4cmpy"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "m4cm",
        "aliases": [
          "M4 Circuit Macros",
          "m4cm"
        ],
        "extensions": [
          ".m4cm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "m4cm",
        "scopeName": "source.m4cm",
        "path": "./syntaxes/m4cm.tmLanguage.json"
      }
    ]
  }
}
