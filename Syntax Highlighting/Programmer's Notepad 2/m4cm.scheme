<?xml version="1.0" encoding="UTF-8"?>
<Scheme>
	<keyword-classes>
		<keyword-class name="m4">
			builtin changecom changequote debugfile debugmode decr define defn divert divnum dnl dumpdef errprint esyscmd eval format ifdef ifelse include incr index indir len m4exit m4wrap maketemp mkstemp patsubst popdef pushdef regexp shift sinclude substr syscmd sysval traceoff traceon translit undefine undivert
		</keyword-class>
		<keyword-class name="pic">
			.b .bot .bottom .c .center .centre .diam .diameter .e .east .end .height .ht .l .left .len .length .n .ne .north .nw .r .rad .radius .right .s .se .south .start .sw .t .thick .thickness .top .w .west .wid .width .x .y 1st 2nd 3rd 4th 5th 6th 7th 8th 9th above abs acos and arc arcrad arrow arrowhead arrowht arrowwid asin at atan2 below between bottom box boxht boxrad boxwid by ccw center centre chop circle circlerad color colored colour coloured command continue copy cos cw dashed dashwid define diam diameter do dotted down dpicopt ellipse ellipseht ellipsewid else end exec exp expe fill filled fillval floor for from height Here ht if int invis invisible last left line lineht linethick linewid ljust log loge max maxpsht maxpswid min move moveht movewid of optMFpic optMpost optPDF optPGF optPict2e optPS optPSfrag optPSTricks optsafe optSVG optTeX opttTeX optxfig outline outlined pmod print rad radius rand reset right rjust same scale scaled sh shade shaded sign sin solid spline sprintf sqrt start tan textht textoffset textwid the then thick thickness to top undef undefine up way wid width with
		</keyword-class>
		<keyword-class name="cm">
			<!--keywords from M4 Macros for Electric Circuit Diagrams in LATEX Documents, by Dwight Aplevich, Version 11.1-->
			above_ abs_ ACsymbol adc addtaps adjust Along_ along_ amp And AND_gate AND_gen AND_ht AND_wd antenna arca ArcAngle arcd arcdimension_ arcr arcto arcwinding array array2 arraymax arraymin arrester arrowline assign3 AutoGate Autologix b_ b_current basename_ battery beginshade bell below_ Between_ bi_tr bi_trans binary_ bisect BOX_gate boxcoord boxdim bp__ bswitch BUF_ht BUF_wd Buffer BUFFER_gate BUFFER_gen buzzer c_fet cangle capacitor case cbreaker ccoax cct_init cct_minus cct_plus centerline_ Cintersect clabel cm__ cmyktorgb ColoredV consource contact contacts contline copy3 copythru corner Cos cosd Cosine cross cross3 cross3D crossover crosswd_ csdim_ d_fet dabove dac Darc darc Darlington Darrow darrow darrow_init dashline dbelow dcosine3D DCsymbol DefineCMYKColor DefineHSVColor DefineRGBColor definergbcolor delay delay_rad_ deleminit_ Deltasymbol Demux dend dfillcolor dfitcurve dfitpoints diff3 diff3D diff_ dimen_ dimension_ diode DIP dir_ distance dlabel dleft Dline dline dlinewid dljust dn_ dna_ dnm_ dot dot3 dot3D dotrad_ down_ dpquicksort dprot dprtext dright drjust dswitch dtee dtor_ dturn e_ E__ e_fet earphone ebox elchop eleminit_ elen_ ellipsearc em_arrows endshade Equidist3 expe f_box Fe_fet Fector FF_ht FF_wid fill_ findroot fitcurve FlipFlop FlipFlopX for_ foreach_ FTcap fuse g_ g_fet G_hht gap geiger gen_init glabel_ gpar_ gpolyline_ graystring grid_ ground gshade gyrator H_ht hatchbox Header HeaderPin heater heatere heatert heatsink hex_digit hexadecimal_ histbins hlth hoprad_ hsvtorgb ht_ ifdpic ifgpic ifinstr ifmfpic ifmpost ifpgf ifpostscript ifpsfrag ifpstricks ifroff ifxfig igbt in__ incircle indicator inductor inner_prod Int_ integrator Intersect_ intersect_ IOdefs j_fet jack jumper KelvinR l_coil l_contact L_unit lamp langle larrow lbox LCintersect LCtangent left_ LEintersect length3 length3D LEtangent lg_bartxt lg_pin lg_pintxt lg_plen LH_symbol lin_ang lin_leng linethick_ ljust_ llabel loc_ log10E_ log_init loge loop Loopover_ lp_xy lpop lswitch lt_ LT_symbol lthick m4_arrow m4dupstr m4lstring m4xpand m4xtract Magn manhattan Max memristor microphone Min Mitre_ mitre_ mm__ mosfet Mux Mux_ht Mux_wid Mx_pins n_ N_diam N_rad Nand NAND_gate ne_ NeedDpicTools neg_ Nor NOR_gate norator Not NOT_circle NOT_gate NOT_rad NPDT nport nterm nullator nw_ Nxor NXOR_gate opamp open_arrow Or OR_gate OR_gen OR_rad parallel_ pc__ Pconn pconnex PerpTo perpto pi_ plug pmod Point_ point_ polar_ polygon posarray posarray2 potentiometer print3D prod_ project Proxim proximity psset_ pt__ PtoL ptrans pushkey_ pushkeys_ pvcell px__ r_ r_stub r_text randn rarrow Rect_ rect_ reed relay relaycoil resetdir_ resetrgb resistor resized restorem4dir reversed rgbdraw rgbfill rgbstring rgbtocmyk rgbtohsv right_ RightAngle rjust_ rlabel rot3Dx rot3Dy rot3Dz Rot_ rot_ RotarySwitch rotbox rotellipse round rpoint_ rpos_ rrot_ rs_box rsvec_ rt_ rtod_ rtod__ rvec_ rvec_r s_ s_box s_dp s_ht s_init s_name s_wd sarrow savem4dir sbs sc_draw scr scs se_ series_ setdir_ setkey_ setkeys_ setrgb setview sfg_init sfgabove sfgarc sfgbelow sfgline sfgnode sfgself shade shadebox shadedball ShadedPolygon ShadeObject shadowed shielded sidac SIdefaults sign_ Sin sinc sind sinusoid sl_box sl_breaker sl_busbar sl_capacitor sl_ct sl_disk sl_drawout sl_generator sl_grid sl_inductor sl_inverter sl_lamp sl_load sl_meterbox sl_reactor sl_rectifier sl_slash sl_transformer sl_transformer3 sl_ttbox slantbox source sourcerad_ sp_ speaker sprod3 sprod3D sqrta SQUID stackargs_ stackcopy_ stackdo_ stackexec_ stackprint_ stackpromote_ stackreverse_ stacksplit_ sum3 sum3D sum_ sus svec_ sw_ switch ta_xy tapped tbox tconn testexpr tgate thermocouple thicklines_ thinlines_ threeD_init thyristor thyristor_t tikznode tline ToPos tr_xy tr_xy_init transformer tstrip ttmotor twopi_ ujt unit3D up_ up__ variable Vcoords_ Vdiff_ vec3 vec_ vec_r View3D vlength Vperp vperp vrot_ vscal_ Vsprod_ Vsum_ w_ while_ wid_ winding Xor XOR_gate XOR_off xtal xtract Ysymbol zabs zarg Zcos Zdiff Zexp Zinv Zprod Zsin Zsum 
		</keyword-class>
	</keyword-classes>
	<language name="M4CM" title="M4 Circuit Macros" folding="true" foldcomments="true" foldcompact="false">
		<lexer name="python" />
		<comments line="#" />
		<property name="tab.timmy.whinge.level" value="1"/>
		<use-keywords>
			<keyword key="0" name="Keywords" class="pic"/>
			<keyword key="1" name="Keywords 2" class="cm"/>
			<keyword key="2" name="Keywords 3" class="m4"/>
		</use-keywords>
		<use-styles>
			<style name="Default" key="32" />
			<style name="Whitespace" key="0" class="whitespace" />
			<style name="Comment" key="1" class="comment"/>
			<style name="Number" key="2" class="number"/>
			<style name="String" key="3" class="string"/>
			<style name="Single-Quoted String" key="4" class="string"/>
			<style name="Keywords" key="5" class="keyword"/>
			<style name="Keywords 2" key="6" class="keyword"/>
			<style name="Keywords 3" key="7" class="keyword" fore="7f7f7f"/>
			<style name="Class name" key="8" class="class"/>
			<style name="Preprocessor" key="9" class="preprocessor"/>
			<style name="Operators" key="10" bold="true"/>
			<style name="Identifiers" key="11"/>
			<style name="Comment block" key="12" fore="7f7f7f" />
			<style name="Unclosed string" key="13" class="string" back="e0c0e0" eolfilled="true" />
			<style name="Highlighted Identifiers" key="14" fore="407090" />
			<style name="Decorators" key="15" fore="805080" />
		</use-styles>
	</language>
</Scheme>